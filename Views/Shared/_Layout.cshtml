<!DOCTYPE html>
<html lang="kk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#101828" />
    <title>@ViewData["Title"] · ProductCatalog</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg">
            <div class="container">
                <a class="navbar-brand brand-lockup" asp-controller="Products" asp-action="Index" aria-label="ProductCatalog — басты бет">
                    <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                    <span>Product<span class="brand-accent">Catalog</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Мәзірді ашу">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index">Басты бет</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index" asp-fragment="catalog">Каталог</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index" asp-fragment="categories">Санаттар</a></li>
                        <li class="nav-item"><a class="nav-link" asp-controller="Products" asp-action="Index" asp-fragment="about">Біз туралы</a></li>
                    </ul>
                    <form class="header-search" asp-controller="Products" asp-action="Index" method="get" role="search">
                        <span class="search-icon" aria-hidden="true">⌕</span>
                        <input type="search" name="search" value="@ViewBag.Search" placeholder="Тауар іздеу..." aria-label="Тауар іздеу" />
                        @if (!string.IsNullOrWhiteSpace(ViewBag.SelectedCategory as string))
                        {
                            <input type="hidden" name="category" value="@ViewBag.SelectedCategory" />
                        }
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="site-footer" id="about">
        <div class="container">
            <div class="footer-main">
                <div class="footer-brand">
                    <a class="brand-lockup footer-logo" asp-controller="Products" asp-action="Index">
                        <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span><span></span></span>
                        <span>Product<span class="brand-accent">Catalog</span></span>
                    </a>
                    <p>Күнделікті өміріңізге арналған заманауи технологиялар мен сенімді өнімдер.</p>
                </div>
                <div class="footer-links">
                    <h2>Навигация</h2>
                    <a asp-controller="Products" asp-action="Index">Басты бет</a>
                    <a asp-controller="Products" asp-action="Index" asp-fragment="catalog">Каталог</a>
                    <a asp-controller="Products" asp-action="Index" asp-fragment="categories">Санаттар</a>
                </div>
                <div class="footer-links">
                    <h2>Байланыс</h2>
                    <a href="mailto:hello@productcatalog.kz">hello@productcatalog.kz</a>
                    <a href="tel:+77001234567">+7 (700) 123-45-67</a>
                    <span>Астана, Қазақстан</span>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2026 ProductCatalog. Барлық құқықтар қорғалған.</span>
                <span>Қазақстанда жасалған <span aria-label="Қазақстан">🇰🇿</span></span>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
